{
  "name": "mcp-t4f-multitenant",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP multi-tenant de solo lectura: cada persona lee su propio banco de señales de tools4foresight con su propia API key (pass-through, sin credenciales en el servidor).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx watch src/http.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.12",
    "typescript": "^5.7",
    "vitest": "^4.1.11",
    "eslint": "^9",
    "typescript-eslint": "^8"
  }
}

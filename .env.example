# LLM: Ollama Cloud para análisis (key de Frida)
OLLAMA_API_KEY=""
OLLAMA_HOST="https://ollama.com"
OLLAMA_MODEL="gpt-oss:120b"

# LLM: OpenAI para embeddings (key de Frida)
OPENAI_API_KEY=""

# Auth (better-auth, magic link + email/password)
AUTH_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
MAGIC_LINK_FROM_EMAIL=""

# Cron (Vercel)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

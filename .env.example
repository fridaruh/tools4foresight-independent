# Copiar a .env y completar con valores reales (nunca commitear .env)

DATABASE_URL="postgresql://user:password@localhost:5432/x_likes_curator?schema=public"

# X API — App en developer.x.com — tab "Keys and tokens"
X_API_CONSUMER_KEY=""
X_API_CONSUMER_SECRET=""
X_API_BEARER_TOKEN=""

# X API — habilitar OAuth 2.0 en "User authentication settings" del App
X_OAUTH_CLIENT_ID=""
X_OAUTH_CLIENT_SECRET=""
X_OAUTH_REDIRECT_URI="http://127.0.0.1:3000/api/auth/x/callback"

# AES-256-GCM, 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Categorizacion automatica — Ollama (ollama.com/settings/keys)
OLLAMA_API_KEY=""
# Default https://ollama.com (Ollama Cloud). Para una instancia local: http://127.0.0.1:11434
OLLAMA_HOST="https://ollama.com"
# Default gpt-oss:120b. Alternativa que corre en una Mac: gpt-oss:20b
OLLAMA_MODEL="gpt-oss:120b"

# Columna Foresight de la tabla de analisis — Claude (claude-opus-5)
ANTHROPIC_API_KEY=""

# CRON_SECRET: autentica los jobs. Mismo valor que le das a Vercel
# (Project Settings -> Cron Jobs). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# ADMIN_PASSWORD: gate legacy de Fase 0 ("Acceso admin" en /login), cookie sin
# usuario detras. Se retira cuando ya no haga falta.
ADMIN_PASSWORD=""

# Auth real (better-auth): magic link y email+contraseña. Generar AUTH_SECRET con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# resend.com/api-keys — magic link y correos de onboarding
RESEND_API_KEY=""
# Direccion remitente (dominio verificado en Resend). El nombre visible siempre
# sale como "Tools 4 Foresight" (src/lib/email-from.ts).
MAGIC_LINK_FROM_EMAIL="tools4foresight <onboarding@resend.dev>"

# POST /api/jobs/onboarding-preview: manda los 7 correos de onboarding a un buzon
# de prueba con "Authorization: Bearer <este valor>". Solo hace falta si se usa.
ONBOARDING_PREVIEW_SECRET=""

# --- Grafo semantico (embeddings con Ollama LOCAL) ---
# ollama.com no hostea modelos de embeddings, asi que el job de embeddings
# (POST /api/jobs/embed) corre contra un Ollama local (`ollama serve` +
# `ollama pull embeddinggemma`) desde la maquina de Frida, no desde Vercel.
# Todos opcionales; estos son los defaults:
# OLLAMA_EMBED_HOST="http://127.0.0.1:11434"
# OLLAMA_EMBED_MODEL="embeddinggemma"   # 768 dims — empata con vector(768) en la DB
# SEMANTIC_LINK_THRESHOLD="0.55"        # similitud coseno minima para crear arista
# SEMANTIC_LINK_TOP_K="8"               # vecinos maximos por señal
# SEMANTIC_CLUSTER_MIN_SIZE="3"         # señales minimas para que una comunidad sea un tema con nombre

# --- Pagos (Stripe, Fase 4) ---
# Instalado via Vercel Marketplace (`vercel integration add stripe`): la integracion
# inyecta STRIPE_SECRET_KEY en Vercel; en local, `vercel env pull`. Sin esta
# variable los pagos quedan apagados y todos los members tienen acceso completo
# (src/lib/require-admin.ts getAccess).
STRIPE_SECRET_KEY=""
# Firma del webhook POST /api/billing/webhook. En el dashboard: Developers ->
# Webhooks -> Add endpoint (eventos checkout.session.completed y
# customer.subscription.created/updated/deleted). En local: `stripe listen
# --forward-to localhost:3000/api/billing/webhook` imprime un whsec_ de prueba.
STRIPE_WEBHOOK_SECRET=""
# Opcionales. Los precios ($15/mes, $150/año, trial de 14 dias con tarjeta) se
# buscan por lookup_key (t4f_monthly / t4f_annual) y se crean solos si no
# existen en la cuenta. Fijar estos ids solo si se quieren usar otros precios.
# STRIPE_PRICE_MONTHLY=""
# STRIPE_PRICE_ANNUAL=""
# URL publica para las redirecciones de Stripe (success/cancel/return). Si no
# esta, se usa el origin de la request.
# NEXT_PUBLIC_APP_URL="https://tools4foresight.com"

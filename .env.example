# Base de datos (Neon Postgres + pgvector)
#
# DATABASE_URL = runtime de la app. Host *-pooler* y rol SIN BYPASSRLS (t4f_app):
#   en Neon el rol dueño (neondb_owner) trae BYPASSRLS y no se le puede quitar, y
#   con ese rol las políticas de RLS no aplican nunca. Crear el rol con:
#     npm run db:app-role
# DIRECT_URL   = migraciones y scripts de plataforma. Host sin pooler, rol dueño.
DATABASE_URL="postgresql://t4f_app:...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# OAuth 2.0 con X (Twitter)
X_OAUTH_CLIENT_ID=""
X_OAUTH_CLIENT_SECRET=""
X_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# Cifrado de secretos por tenant (AES-256-GCM, 32 bytes en base64).
# Los blobs se guardan como `v1.<iv>.<tag>.<ct>` — el `v1.` es la versión del
# esquema (src/lib/token-crypto.ts).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
# Solo durante una rotación de clave (npx tsx scripts/rotate-encryption-key.ts):
#   _NEXT = la clave destino, la que va a quedar. Se pone ANTES de correr el
#           script, para que la app ya sepa leer lo que el script re-cifre.
#   _PREV = la clave vieja, unos días después de promover, por si quedó algún
#           blob sin migrar. Borrar las dos cuando la rotación termine.
TOKEN_ENCRYPTION_KEY_NEXT=""
TOKEN_ENCRYPTION_KEY_PREV=""

# LLM: Ollama Cloud para análisis (key de Frida)
OLLAMA_API_KEY=""
OLLAMA_HOST="https://ollama.com"
OLLAMA_MODEL="gpt-oss:120b"

# LLM: OpenAI para embeddings (key de Frida)
OPENAI_API_KEY=""

# Auth (better-auth, magic link + email/password)
AUTH_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
MAGIC_LINK_FROM_EMAIL=""

# Alertas de plataforma a Frida (PLAN Fase 5.2, src/lib/alerts.ts). Sin
# RESEND_API_KEY o sin este email, las alertas solo se loguean con console.warn.
ADMIN_ALERT_EMAIL=""
# Umbrales diarios que disparan la alerta de gasto de GET /api/jobs/alerts
# (cron sugerido: 0 9 * * *). Si se dejan vacíos rigen los defaults del código
# (5000 llamadas Ollama/día, 5_000_000 tokens OpenAI/día).
ALERT_OLLAMA_CALLS_PER_DAY=""
ALERT_OPENAI_TOKENS_PER_DAY=""

# Cron (Vercel)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de datos (Neon Postgres + pgvector)
#
# DATABASE_URL = runtime de la app. Host *-pooler* y rol SIN BYPASSRLS (t4f_app):
#   en Neon el rol dueño (neondb_owner) trae BYPASSRLS y no se le puede quitar, y
#   con ese rol las políticas de RLS no aplican nunca. Crear el rol con:
#     npm run db:app-role
# DIRECT_URL   = migraciones y scripts de plataforma. Host sin pooler, rol dueño.
DATABASE_URL="postgresql://t4f_app:...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# OAuth 2.0 con X (Twitter)
X_OAUTH_CLIENT_ID=""
X_OAUTH_CLIENT_SECRET=""
X_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# Cifrado de tokens (AES-256-GCM, 32 bytes en base64)
TOKEN_ENCRYPTION_KEY=""

# LLM: Ollama Cloud para análisis (key de Frida)
OLLAMA_API_KEY=""
OLLAMA_HOST="https://ollama.com"
OLLAMA_MODEL="gpt-oss:120b"

# LLM: OpenAI para embeddings (key de Frida)
OPENAI_API_KEY=""

# Auth (better-auth, magic link + email/password)
AUTH_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
MAGIC_LINK_FROM_EMAIL=""

# Cron (Vercel)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

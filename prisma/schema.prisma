// Prisma schema para tools4foresight (multi-tenant).
//
// Regla no negociable (PLAN §1): TODA tabla del pipeline lleva `owner_id`
// (o `user_id` para las tablas 1:1 con el usuario) y TODO query lo filtra,
// incluido cada $queryRaw/$executeRaw. La segunda barrera es RLS en Postgres
// (migración `_rls`): las políticas leen `current_setting('app.owner_id')`, que
// se fija con `withOwner()` de src/lib/tenant-db.ts dentro de una transacción.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (better-auth, magic link) ---

// Un tenant = un User. `role` distingue al dueño de la plataforma (Frida) del
// resto; NO controla el acceso al banco de señales: cada usuario es dueño del
// suyo y lo ve completo.
//   user           -> usuario normal, dueño de su tenant
//   platform_admin -> Frida: panel /admin, cuotas, flags globales (Fase 5)
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  // Tenant: todo lo de abajo muere con el usuario (borrar cuenta = borrar banco).
  xAuthToken            XAuthToken?
  ingestionCursor       IngestionCursor?
  quota                 UserQuota?
  usageEvents           UsageEvent[]
  categories            Category[]
  jobRuns               JobRun[]
  likedItems            LikedItem[]
  likedItemCustomFields LikedItemCustomField[]
  customFieldDefs       CustomFieldDefinition[]
  semanticLinks         SemanticLink[]
  semanticClusters      SemanticCluster[]
  graphSnapshots        GraphSnapshot[]
  graphSnapshotClusters GraphSnapshotCluster[]
  graphSnapshotMembers  GraphSnapshotMember[]
  promptSettings        PromptSetting[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Sin proveedores OAuth por ahora (magic link + password), pero better-auth la
// pide igual: `accounts.password` guarda el hash del registro con contraseña.
model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

// Donde el plugin de magic link guarda el token mientras no se usa.
model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

// --- Tenant: cuotas y uso ---

// Límites y contadores por tenant. Los contadores se reinician cuando
// `windowResetAt` queda en el pasado (ver src/lib/quota.ts, Fase 2).
model UserQuota {
  userId             String   @id @map("user_id")
  xPagesPerDay       Int      @default(2) @map("x_pages_per_day")
  xBackfillPages     Int      @default(3) @map("x_backfill_pages")
  xBackfillMonths    Int      @default(3) @map("x_backfill_months")
  analyzeItemsPerDay Int      @default(150) @map("analyze_items_per_day")
  xPagesUsedToday    Int      @default(0) @map("x_pages_used_today")
  analyzeUsedToday   Int      @default(0) @map("analyze_used_today")
  windowResetAt      DateTime @default(now()) @map("window_reset_at")
  pipelineEnabled    Boolean  @default(true) @map("pipeline_enabled")
  // Marca de "el grafo de este tenant quedó sucio" (publicó/despublicó algo).
  // El cron de grafo solo procesa tenants con graphDirtyAt != null (PLAN 3.10).
  graphDirtyAt       DateTime? @map("graph_dirty_at")
  // Cooldowns de las acciones manuales del usuario (PLAN 3.10 / 3.12). No son
  // cuotas: son antirrebote para que un click repetido no dispare N pipelines.
  //   lastManualSyncAt    -> POST /api/sync            (30 min)
  //   lastGraphRefreshAt  -> POST /api/jobs/graph/now  (10 min)
  lastManualSyncAt   DateTime? @map("last_manual_sync_at")
  lastGraphRefreshAt DateTime? @map("last_graph_refresh_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

// Auditoría de costo por tenant: una fila por llamada externa.
model UsageEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // x_page | ollama_call | openai_embed | fetch
  kind      String
  units     Int
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("usage_events")
}

// Estado de cada corrida de job por tenant (reemplaza el "remaining" global).
model JobRun {
  id         String    @id @default(uuid())
  ownerId    String    @map("owner_id")
  // ingest | fetch | categorize | analyze | embed | graph
  job        String
  // queued | running | ok | error | budget
  status     String    @default("queued")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  processed  Int       @default(0)
  remaining  Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, job, startedAt(sort: Desc)])
  @@map("job_runs")
}

// Flags globales de la plataforma (NO es tabla de tenant, no lleva RLS).
// Hoy: "x_credits_depleted" -> la X App compartida se quedó sin créditos.
model PlatformFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_flags")
}

// Rate limit distribuido en Postgres (NO es tabla de tenant, no lleva RLS).
// Se usa con INSERT ... ON CONFLICT para sincronizar entre instancias serverless.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

// --- Tenant: conexión con X ---

model XAuthToken {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  xUserId      String   @map("x_user_id")
  // @handle de la cuenta conectada (sin arroba), leído de /2/users/me en el
  // callback (PLAN 4.2): xUserId es el ID numérico y no se puede mostrar tal
  // cual en /conexion. Null en tokens creados antes de esta columna hasta la
  // próxima reconexión.
  xUsername    String?  @map("x_username")
  accessToken  String   @map("access_token") // cifrado a nivel de aplicación
  refreshToken String   @map("refresh_token") // cifrado a nivel de aplicación
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sin unique global sobre xUserId: la validación "esa cuenta de X ya está
  // conectada a otro usuario" se hace en el callback (Fase 2.1), porque con RLS
  // un unique global filtraría existencia entre tenants.
  @@index([xUserId])
  @@map("x_auth_tokens")
}

model IngestionCursor {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  lastTweetId           String?   @map("last_tweet_id")
  lastRunAt             DateTime? @map("last_run_at")
  // Estado de la última corrida, para que la UI pueda avisar cosas como
  // "necesitas recargar créditos en X" sin volver a correr el job.
  lastStatus            String    @default("idle") @map("last_status") // idle | ok | error_credits_depleted | error
  lastError             String?   @map("last_error")
  // Si X respondió 429, hasta cuándo hay que dejar de pedirle (Fase 2.3).
  retryAfter            DateTime? @map("retry_after")
  // Backfill en progreso: pagination_token para retomar donde se quedó y el
  // tweet_id más reciente visto en este ciclo (se fija como last_tweet_id solo
  // cuando el ciclo termina de verdad).
  resumePaginationToken String?   @map("resume_pagination_token")
  pendingNewestTweetId  String?   @map("pending_newest_tweet_id")
  // Extremos del orden de likes ya asignados (rank más alto = like más reciente).
  maxLikeRank           Int?      @map("max_like_rank")
  minLikeRank           Int?      @map("min_like_rank")
  backfillReachedWindow Boolean   @default(false) @map("backfill_reached_window")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ingestion_cursor")
}

// --- Tenant: catálogo de categorías ---

// Reemplaza src/config/categories.ts: cada usuario edita el suyo. Se siembra al
// crear la cuenta (src/lib/seed-tenant.ts) con la plantilla genérica.
model Category {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  description String
  examples    String[] @default([])
  position    Int      @default(0)
  // "Otros": la categoría a la que cae lo que el modelo no supo clasificar.
  isFallback  Boolean  @default(false) @map("is_fallback")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId, position])
  @@map("categories")
}

// --- Tenant: el pipeline ---

model LikedItem {
  id      String @id @default(uuid())
  ownerId String @map("owner_id")

  // De donde salió el item:
  //   x_like -> lo trajo la ingesta de likes de X
  //   manual -> el usuario pegó el enlace a mano en la pantalla de enriquecimiento
  // Un item manual no tiene tweet detrás pero ocupa las mismas columnas: `tweetId`
  // lleva un id sintético (manual:<uuid>), `tweetUrl`/`tweetText` la URL y
  // `authorHandle` el dominio.
  source String @default("x_like")

  tweetId      String   @map("tweet_id")
  authorHandle String   @map("author_handle")
  authorName   String?  @map("author_name")
  tweetText    String   @map("tweet_text")
  tweetUrl     String   @map("tweet_url")
  mediaUrls    String[] @default([]) @map("media_urls")

  // --- Las tres fechas del item ---
  //   tweetCreatedAt -> exacto, derivado del snowflake ID del tweet
  //   detectedAt     -> exacto, el momento del polling que lo trajo
  //   likedAt        -> ESTIMACIÓN acotada entre ambos; es sobre lo que filtra la UI
  tweetCreatedAt DateTime? @map("tweet_created_at")
  detectedAt     DateTime? @map("detected_at")
  likedAt        DateTime  @map("liked_at")
  likedAtSource  String    @default("tweet_date") @map("liked_at_source")
  // Posición en el orden de likes del tenant (más alto = like más reciente).
  likeRank       Int?      @map("like_rank")

  // contenido enlazado (nullable: no todo tweet tiene link externo)
  contentUrl         String?   @map("content_url")
  contentTitle       String?   @map("content_title")
  contentDescription String?   @map("content_description")
  contentImageUrl    String?   @map("content_image_url")
  contentPublishedAt DateTime? @map("content_published_at")
  fetchedAt          DateTime? @map("fetched_at")
  fetchStatus        String    @default("pending") @map("fetch_status") // pending | success | failed | not_applicable

  // categorización (contra el catálogo del tenant)
  category           String?
  categorySource     String    @default("auto") @map("category_source") // auto | manual
  categoryConfidence Decimal?  @map("category_confidence")
  categoryReasoning  String?   @map("category_reasoning")
  categorizedAt      DateTime? @map("categorized_at")

  // PESTEL: guarda las claves de config/pestel.ts, no las etiquetas.
  // 'manual' congela el valor para que el job no lo pise (igual que category).
  pestel       String[] @default([])
  pestelSource String   @default("auto") @map("pestel_source") // auto | manual

  // Etiquetas libres (3 a 5), descriptivas del contenido, generadas por Ollama.
  // A diferencia de `category` (una sola, catálogo cerrado por tenant) y `pestel`
  // (catálogo fijo), estas son texto libre — no hay tabla de catálogo detrás.
  // 'manual' congela el valor igual que category/pestel.
  tags            String[]  @default([])
  tagsSource      String    @default("auto") @map("tags_source") // auto | manual
  tagsGeneratedAt DateTime? @map("tags_generated_at")

  // Textos generados. `*Source = 'manual'` congela el texto: el job no lo pisa.
  tldr            String?
  tldrSource      String    @default("auto") @map("tldr_source")
  tldrGeneratedAt DateTime? @map("tldr_generated_at")

  impact            String?
  impactSource      String    @default("auto") @map("impact_source")
  impactGeneratedAt DateTime? @map("impact_generated_at")

  whyMatters            String?   @map("why_matters")
  whyMattersSource      String    @default("auto") @map("why_matters_source")
  whyMattersGeneratedAt DateTime? @map("why_matters_generated_at")

  // Descartado de la tabla de enriquecimiento, NO del catálogo.
  enrichDiscarded Boolean @default(false) @map("enrich_discarded")

  // pending -> sin revisar. published -> entra al grafo y a los horizontes.
  publishStatus String    @default("pending") @map("publish_status")
  publishedAt   DateTime? @map("published_at")

  // --- Grafo semántico ---
  // Embedding del texto de la señal (tldr + whyMatters + título). Desde Fase 3 lo
  // genera OpenAI text-embedding-3-small (1536 dims). `Unsupported` porque Prisma
  // no habla pgvector: se lee/escribe con $queryRaw — SIEMPRE dentro de withOwner().
  embedding     Unsupported("vector(1536)")?
  embeddingHash String?                      @map("embedding_hash")
  embeddedAt    DateTime?                    @map("embedded_at")

  clusterId String?          @map("cluster_id")
  cluster   SemanticCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  // Vitalidad de la señal: 0.5^(días desde likedAt/30), reanimada por vecinas
  // recientes. Vida media 30 días (decisión de Frida).
  vitality   Float?
  vitalityAt DateTime? @map("vitality_at")

  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customFields LikedItemCustomField[]
  linksAsA     SemanticLink[]         @relation("SemanticLinkA")
  linksAsB     SemanticLink[]         @relation("SemanticLinkB")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ownerId, tweetId])
  @@index([ownerId, likedAt(sort: Desc)])
  @@index([ownerId, category])
  @@index([ownerId, fetchStatus])
  @@index([ownerId, enrichDiscarded])
  @@index([ownerId, publishStatus])
  @@index([clusterId])
  @@map("liked_items")
}

// Arista del grafo semántico: similitud coseno entre dos señales publicadas DEL
// MISMO tenant. El par va ordenado (itemAId < itemBId) para deduplicar A-B y B-A.
model SemanticLink {
  id      String @id @default(uuid())
  ownerId String @map("owner_id")
  itemAId String @map("item_a_id")
  itemBId String @map("item_b_id")
  score   Float

  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  itemA LikedItem @relation("SemanticLinkA", fields: [itemAId], references: [id], onDelete: Cascade)
  itemB LikedItem @relation("SemanticLinkB", fields: [itemBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ownerId, itemAId, itemBId])
  @@index([ownerId])
  @@index([itemBId])
  @@map("semantic_links")
}

// Tema del grafo: comunidad de señales densamente conectadas entre sí. La fila es
// un LINAJE: sobrevive entre corridas (se empareja por solapamiento de miembros),
// acumula indicadores y puede morir y resucitar.
model SemanticCluster {
  id          String @id @default(uuid())
  ownerId     String @map("owner_id")
  name        String
  summary     String
  membersHash String @map("members_hash")
  size        Int

  // alive | dead. La muerte es reversible (decisión de Frida).
  status        String    @default("alive")
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSignalAt  DateTime? @map("last_signal_at")
  diedAt        DateTime? @map("died_at")
  revivedCount  Int       @default(0) @map("revived_count")
  vitality      Float     @default(0)
  lastMemberIds String[]  @default([]) @map("last_member_ids")

  // Horizonte (H1 | H2 | H3). `horizon` es el efectivo, `horizonSuggested` lo que
  // la heurística propone; horizonSource='manual' congela el efectivo.
  horizon          String?
  horizonSuggested String? @map("horizon_suggested")
  horizonSource    String  @default("auto") @map("horizon_source")

  // Indicadores de la última corrida (el historial vive en graph_snapshot_clusters).
  velocity30d     Int    @default(0) @map("velocity_30d")
  velocityPrev30d Int    @default(0) @map("velocity_prev_30d")
  density         Float?
  connectivity    Float?
  novelty         Float?
  bridgeClusters  Int    @default(0) @map("bridge_clusters")

  owner     User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     LikedItem[]
  snapshots GraphSnapshotCluster[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([ownerId, membersHash])
  @@map("semantic_clusters")
}

// Una fila por corrida del grafo de un tenant (refreshGraph).
model GraphSnapshot {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  takenAt       DateTime @default(now()) @map("taken_at")
  // embed | cron | publish | manual: qué disparó la corrida.
  trigger       String
  nodes         Int
  links         Int
  clustersAlive Int      @map("clusters_alive")
  clustersDead  Int      @map("clusters_dead")
  orphans       Int

  owner    User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clusters GraphSnapshotCluster[]
  members  GraphSnapshotMember[]

  @@index([ownerId, takenAt(sort: Desc)])
  @@map("graph_snapshots")
}

// Serie temporal por tema: cómo estaba cada linaje en cada snapshot.
model GraphSnapshotCluster {
  id         String @id @default(uuid())
  ownerId    String @map("owner_id")
  snapshotId String @map("snapshot_id")
  clusterId  String @map("cluster_id")

  name             String
  size             Int
  status           String
  vitality         Float
  velocity30d      Int     @map("velocity_30d")
  density          Float?
  connectivity     Float?
  novelty          Float?
  horizon          String?
  horizonSuggested String? @map("horizon_suggested")

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshot GraphSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  cluster  SemanticCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, clusterId])
  @@index([ownerId])
  @@index([clusterId])
  @@map("graph_snapshot_clusters")
}

// Membresía señal→tema en cada snapshot, con la vitalidad de ese momento.
model GraphSnapshotMember {
  ownerId    String  @map("owner_id")
  snapshotId String  @map("snapshot_id")
  itemId     String  @map("item_id")
  clusterId  String? @map("cluster_id")
  vitality   Float

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshot GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, itemId])
  @@index([ownerId])
  @@map("graph_snapshot_members")
}

// Columnas extra que el usuario agrega desde la pantalla de enriquecimiento.
model CustomFieldDefinition {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  fieldKey  String   @map("field_key")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, fieldKey])
  @@map("custom_field_definitions")
}

// Valor de una columna extra en un item. Lleva `ownerId` propio (denormalizado
// desde liked_items) para que la política de RLS no tenga que hacer un join.
model LikedItemCustomField {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  likedItemId String    @map("liked_item_id")
  likedItem   LikedItem @relation(fields: [likedItemId], references: [id], onDelete: Cascade)
  fieldKey    String    @map("field_key")
  fieldValue  String?   @map("field_value")
  createdAt   DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([likedItemId, fieldKey])
  @@index([ownerId])
  @@map("liked_item_custom_fields")
}

// Overrides de los system prompts del análisis, por tenant. Si no hay fila para
// una clave, rige el default de src/lib/analysis-prompts.ts.
// Claves: "tldr" | "impact" | "why_matters".
model PromptSetting {
  ownerId   String   @map("owner_id")
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, key])
  @@map("prompt_settings")
}
